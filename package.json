{
  "name": "conversion_tool",
  "private": true,
  "version": "1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "engines:python": "bash conversion-engines/python/build-worker.sh",
    "engines:poppler:mac": "bash conversion-engines/scripts/stage-poppler-macos.sh",
    "engines:python:win": "powershell -ExecutionPolicy Bypass -File conversion-engines/python/build-worker.ps1",
    "engines:poppler:win": "powershell -ExecutionPolicy Bypass -File conversion-engines/scripts/stage-poppler-windows.ps1",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.6",
    "fast-xml-parser": "^5.3.6",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "studio.formatconversion.app",
    "productName": "Format Conversion Studio",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/ffmpeg-static/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "conversion-engines/python/dist",
        "to": "engines/python"
      },
      {
        "from": "conversion-engines/poppler/dist",
        "to": "engines/poppler"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "icon": "build/icon.svg"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
